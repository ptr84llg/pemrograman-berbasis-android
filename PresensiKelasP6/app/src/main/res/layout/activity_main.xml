<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFAFBFE"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Presensi Kelas"
        android:textColor="#FF1F2937"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Senin, 12 Oktober"
        android:textSize="14sp"
        android:textColor="#FF6B7280"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/txtStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="Status Kehadiran"
        android:textColor="#FF374151"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDate" />

    <TextView
        android:id="@+id/txtStatusValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hadir"
        android:textSize="24sp"
        android:textColor="#FF15803D"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtStatusLabel"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtStatusInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:text="Kehadiran Anda Tercatat"
        android:textColor="#FF6B7280"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtStatusValue" />

    <TextView
        android:id="@+id/txtSummaryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ringkasan (Data Simulasi)"
        android:textSize="18sp"
        android:textColor="#FF1F2937"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtStatusInfo"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/txtHadirLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hadir"
        android:textSize="14sp"
        android:textColor="#FF374151"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtSummaryTitle"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/txtHadirValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14"
        android:textSize="14sp"
        android:textColor="#FF374151"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/txtHadirLabel" />

    <TextView
        android:id="@+id/txtIzinLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Izin"
        android:textSize="14sp"
        android:textColor="#FF374151"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtHadirLabel"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txtIzinValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2"
        android:textSize="14sp"
        android:textColor="#FF374151"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/txtIzinLabel" />

    <TextView
        android:id="@+id/txtAlfaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alfa"
        android:textSize="14sp"
        android:textColor="#FF374151"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtIzinLabel"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txtAlfaValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="14sp"
        android:textColor="#FF374151"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/txtAlfaLabel" />

    <Button
        android:id="@+id/btnAttendance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="#FF2563EB"
        android:text="Catat Kehadiran"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtAlfaLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>

